# ==========================================
# Real Estate Lead Qualification Voice Agent
# Environment Configuration
# ==========================================

# --- Application & Server Settings ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Database Settings ---
# PostgreSQL connection URL (for Docker or production)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_agent
# If left as sqlite or if Postgres is unavailable in local dev, an automatic local SQLite fallback is used.
DATABASE_URL=sqlite+aiosqlite:///./real_estate.db
DATABASE_URL_SYNC=sqlite:///./real_estate.db

# --- OpenAI (LLM) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Speech-to-Text (Deepgram) ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US

# --- Text-to-Speech (ElevenLabs) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Recommended voice: "Rachel" (21m00Tcm4TlvDq8ikWAM) or custom Riya voice ID
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Alternative TTS Fallback (Cartesia) ---
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e998e3-18a7-4fc6-baa7-0e6205ca8337

# --- Telephony (Twilio Programmable Voice) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Public base URL of your deployed backend or ngrok tunnel for Twilio webhooks
PUBLIC_BASE_URL=https://your-domain.up.railway.app
